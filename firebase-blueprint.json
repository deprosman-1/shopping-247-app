{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered customer profile on Depros Boutique",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "defaultAddress": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "phoneNumber"]
    },
    "Order": {
      "title": "Order",
      "description": "Depros Boutique customer purchase and delivery order",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "deliveryCity": { "type": "string" },
        "state": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentReceiptUrl": { "type": "string" },
        "senderAccountName": { "type": "string" },
        "totalAmount": { "type": "number" },
        "itemCount": { "type": "number" },
        "deliveryStatus": { "type": "string" },
        "estimatedDelivery": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "userId", "customerName", "deliveryAddress", "totalAmount", "deliveryStatus"]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "Bookmarked or saved product item for customer",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "brand": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId"]
    },
    "CartItem": {
      "title": "CartItem",
      "description": "Item in user active shopping cart",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "title": { "type": "string" },
        "brand": { "type": "string" },
        "size": { "type": "string" },
        "colorName": { "type": "string" },
        "colorHex": { "type": "string" },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "imageUrl": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "productId", "quantity", "unitPrice"]
    },
    "Product": {
      "title": "Product",
      "description": "Store item catalog in Depros Boutique",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "title": { "type": "string" },
        "brand": { "type": "string" },
        "category": { "type": "string" },
        "basePrice": { "type": "number" },
        "discountPercent": { "type": "number" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "stockQuantity": { "type": "number" },
        "rating": { "type": "number" },
        "sku": { "type": "string" }
      },
      "required": ["productId", "title", "brand", "category", "basePrice"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile document owned by authenticated user"
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer purchase orders with delivery details and payment receipt"
    },
    "/users/{userId}/wishlist/{wishlistId}": {
      "schema": { "$ref": "#/entities/WishlistItem" },
      "description": "Wishlist saved items scoped to user"
    },
    "/users/{userId}/cart/{cartItemId}": {
      "schema": { "$ref": "#/entities/CartItem" },
      "description": "Active shopping cart items scoped to user"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Store products catalog readable by all users"
    }
  }
}
