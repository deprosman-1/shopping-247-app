rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.phoneNumber is string && data.phoneNumber.size() > 0;
    }

    function isValidOrder(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.orderId is string &&
             data.customerName is string && data.customerName.size() > 0 &&
             data.deliveryAddress is string && data.deliveryAddress.size() > 0 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.deliveryStatus is string;
    }

    function isValidWishlist(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.productId is string;
    }

    function isValidCartItem(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.productId is string &&
             data.quantity is number && data.quantity > 0 &&
             data.unitPrice is number && data.unitPrice >= 0;
    }

    // User profile document
    match /users/{userId} {
      allow read, write: if isOwner(userId) && (request.method != 'create' && request.method != 'update' || isValidUser(request.resource.data));

      // Customer Orders subcollection
      match /orders/{orderId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidOrder(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // Customer Wishlist subcollection
      match /wishlist/{wishlistId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidWishlist(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // Customer Cart subcollection
      match /cart/{cartItemId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCartItem(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }

    // Store Product Catalog (Authenticated read, admin-only write)
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
